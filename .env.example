# Copy to .env and fill in what you have. Everything is optional: without keys the store runs fully,
# and Virtual Try-On uses the on-device AI engine.

PORT=3000
SITE_URL=http://localhost:3000
# NODE_ENV=production   # enables Secure cookies (use behind HTTPS)

# --- Photoreal cloud Virtual Try-On (first configured provider that supports the garment wins) ---
# Google Gemini image model: handles sarees + dupattas; also powers `npm run mannequin`.
GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# FASHN.ai dedicated try-on API (kurtas, kurtis, sets; not sarees)
FASHN_API_KEY=
# FASHN_MODEL=tryon-v1.6

# Replicate IDM-VTON (open-source model; kurtas, kurtis, sets; not sarees)
REPLICATE_API_TOKEN=
# REPLICATE_TRYON_MODEL=cuuupid/idm-vton

# Provider priority
# TRYON_PROVIDERS=gemini,fashn,replicate
